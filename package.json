{
  "name": "vp-config-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run --filter './packages/*' build",
    "test": "vp test",
    "test:packages": "bash .github/scripts/test-packages.sh",
    "check": "vp check",
    "knip": "knip",
    "duplication": "jscpd . --pattern '**/src/**/*.ts' --min-tokens 50 --min-lines 5 --fail-on-new-clones"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
