{
  "name": "@jong-kyung/oxlint-plugin",
  "version": "0.1.0",
  "description": "Custom Oxlint rules for TypeScript projects.",
  "homepage": "https://github.com/jong-kyung/vp-config#readme",
  "bugs": {
    "url": "https://github.com/jong-kyung/vp-config/issues"
  },
  "license": "MIT",
  "author": "jong-kyung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jong-kyung/vp-config.git",
    "directory": "packages/oxlint-plugin"
  },
  "files": [
    "dist"
  ],
